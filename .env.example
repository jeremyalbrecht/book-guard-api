# Ex-Libris configuration — copy to .env and adjust.
# Every environment variable the app reads is documented here; keep this file in
# sync whenever a new variable is added.

# ─── Server ──────────────────────────────────────────────────────────────────
# Listen address for the HTTP server.
# Optional. Default: :8080
ADDR=:8080

# ─── Storage ─────────────────────────────────────────────────────────────────
# Storage backend: "memory" (default, no dependencies, data lost on restart) or
# "postgres".
# Optional. Default: memory
STORE=postgres

# Postgres connection string. REQUIRED when STORE=postgres; ignored otherwise.
# The app runs migrations on startup and needs the pgvector extension available
# (the pgvector/pgvector image ships it).
DATABASE_URL=postgres://user:password@localhost:5432/exlibris?sslmode=disable

# ─── Authentication (OIDC / Authelia) ────────────────────────────────────────
# Bypass authentication entirely with a static "dev" identity — LOCAL DEV ONLY,
# never set this in a deployment. When "true", all OIDC_* vars are ignored.
# Optional. Default: unset (auth enforced)
AUTH_DISABLED=true

# OIDC issuer URL (your Authelia base URL). REQUIRED unless AUTH_DISABLED=true.
# Discovery runs at startup against {issuer}/.well-known/openid-configuration.
OIDC_ISSUER=https://auth.example.com

# Expected token audience (the `aud` claim). Set this to the audience your
# Authelia client puts on its access tokens (typically the client id).
# REQUIRED for real OIDC (token validation fails without a matching audience).
OIDC_AUDIENCE=ex-libris

# Require the caller to be a member of this group (403 otherwise). Leave empty to
# allow any authenticated user.
# Optional. Default: empty (no group requirement)
OIDC_REQUIRED_GROUP=book-users

# ─── ISBN enrichment (Open Library) ──────────────────────────────────────────
# Disable the background enrichment worker + reconciler. Book creates still
# succeed, but no metadata/covers are fetched. Useful for offline dev/tests.
# Note: this does NOT disable GET /search, which is a synchronous request a user
# is waiting on rather than background work, and still calls Open Library.
# OPENLIBRARY_BASE_URL applies to both.
# Optional. Default: unset (enrichment enabled)
ENRICH_DISABLED=true

# Override the Open Library metadata host. Mainly for tests/mirrors.
# Optional. Default: https://openlibrary.org
OPENLIBRARY_BASE_URL=https://openlibrary.org

# Override the Open Library covers host. Mainly for tests/mirrors.
# Optional. Default: https://covers.openlibrary.org
OPENLIBRARY_COVERS_URL=https://covers.openlibrary.org
